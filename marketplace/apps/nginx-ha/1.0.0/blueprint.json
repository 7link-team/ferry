{
  "apiVersion": "ferry/blueprint-v1",
  "kind": "Blueprint",
  "metadata": { "name": "nginx-ha" },
  "allowSingleHost": true,
  "roles": [
    {
      "name": "web",
      "instances": { "min": 2, "max": 10, "default": 2 },
      "placement": { "distinctHosts": true },
      "identity": "stateless",
      "ports": [{ "name": "http", "container": 80, "published": "{{ add .Values.web_port .Instance.Index }}" }],
      "service": {
        "image": "nginx:1.27-alpine",
        "command": ["/bin/sh", "-c", "printf '%s from %s\\n' \"$FERRY_MESSAGE\" \"$FERRY_INSTANCE\" > /usr/share/nginx/html/index.html && exec nginx -g 'daemon off;'"],
        "env": [
          { "name": "FERRY_MESSAGE", "value": "{{ .Values.message }}" },
          { "name": "FERRY_INSTANCE", "value": "{{ .Instance.Name }}" }
        ],
        "health": {
          "readiness": { "httpGet": { "path": "/", "port": 80 }, "periodSeconds": 1 },
          "liveness": { "httpGet": { "path": "/", "port": 80 }, "periodSeconds": 5 }
        },
        "resources": { "limits": { "cpu": "500m", "memory": "64Mi" }, "requests": { "memory": "16Mi" } }
      }
    },
    {
      "name": "lb",
      "instances": { "min": 1, "max": 3, "default": 1 },
      "placement": { "distinctHosts": true },
      "identity": "stateless",
      "ports": [{ "name": "http", "container": 80, "published": "{{ add .Values.lb_port .Instance.Index }}" }],
      "service": {
        "image": "nginx:1.27-alpine",
        "command": ["/bin/sh", "-c", "until nginx -t -q; do sleep 1; done; exec nginx -g 'daemon off;'"],
        "files": [{ "path": "/etc/nginx/conf.d/default.conf", "fromTemplate": "nginx-lb.conf" }],
        "health": {
          "readiness": { "httpGet": { "path": "/healthz", "port": 80 }, "periodSeconds": 1 },
          "liveness": { "httpGet": { "path": "/healthz", "port": 80 }, "periodSeconds": 5 }
        },
        "resources": { "limits": { "cpu": "500m", "memory": "64Mi" }, "requests": { "memory": "16Mi" } }
      }
    }
  ],
  "endpoints": [{ "name": "http", "role": "lb", "port": "http", "kind": "direct" }],
  "drivers": {
    "docker": { "supported": true },
    "compose": { "supported": true },
    "native": { "supported": false }
  },
  "update": { "maxParallel": 1, "minHealthySeconds": 5, "healthTimeout": 120, "autoRevert": true },
  "strategy": { "type": "recreate", "healthTimeout": 120 }
}
