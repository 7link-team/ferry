          },
          "restart": "unless-stopped"
        },
        "redis-c": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.data_port_c }} PING | grep -qx PONG"
            ],
            "interval": "2s",
            "timeout": "2s",
            "retries": 15,
            "start_period": "5s"
          },
          "restart": "unless-stopped"
        },
        "sentinel-c": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.sentinel_port_c }} PING | grep -qx PONG"
            ],
            "interval": "2s",
            "timeout": "2s",
            "retries": 15,
            "start_period": "5s"
          },
          "restart": "unless-stopped"
        }
      }
    },
    "stack": {
      "services": {
        "redis-a": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.data_port_a }} PING | grep -qx PONG"
            ],
            "interval": "2s",
            "timeout": "2s",
            "retries": 15,
            "start_period": "5s"
          },
          "deploy": {
            "placement": {
              "constraints": [
                "node.labels.ferry-redis == a"
              ]
            }
          }
        },
        "sentinel-a": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.sentinel_port_a }} PING | grep -qx PONG"
            ],
            "interval": "2s",
            "timeout": "2s",
            "retries": 15,
            "start_period": "5s"
          },
          "deploy": {
            "placement": {
              "constraints": [
                "node.labels.ferry-redis == a"
              ]
            }
          }
        },
        "redis-b": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.data_port_b }} PING | grep -qx PONG"
            ],
            "interval": "2s",
            "timeout": "2s",
            "retries": 15,
            "start_period": "5s"
          },
          "deploy": {
            "placement": {
              "constraints": [
                "node.labels.ferry-redis == b"
              ]
            }
          }
        },
        "sentinel-b": {
