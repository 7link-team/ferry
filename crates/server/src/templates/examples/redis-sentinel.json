      "command": [
        "sh",
        "/etc/example-redis-start.sh"
      ],
      "env": [
        {
          "name": "REDIS_KIND",
          "value": "sentinel"
        },
        {
          "name": "REDIS_NODE_IP",
          "value": "{{ .Values.ip_c }}"
        },
        {
          "name": "REDIS_PORT",
          "value": "{{ .Values.sentinel_port_c }}"
        },
        {
          "name": "REDIS_INITIAL_IP",
          "value": "{{ .Values.ip_a }}"
        },
        {
          "name": "REDIS_INITIAL_PORT",
          "value": "{{ .Values.data_port_a }}"
        },
        {
          "name": "REDIS_INITIAL_ROLE",
          "value": "replica"
        },
        {
          "name": "REDISCLI_AUTH",
          "valueFrom": "{{ .Values.password }}"
        }
      ],
      "ports": [
        {
          "container": "{{ .Values.sentinel_port_c }}",
