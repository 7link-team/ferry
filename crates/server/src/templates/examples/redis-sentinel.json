          "name": "sentinel-c-data",
          "path": "/data"
        }
      ],
      "resources": {
        "limits": {
          "memory": "128Mi"
        }
      }
    }
  ],
  "overrides": {
    "compose": {
      "services": {
        "redis-a": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.data_port_a }} PING | grep -qx PONG"
            ],
            "interval": "2s",
            "timeout": "2s",
            "retries": 15,
            "start_period": "5s"
          },
          "restart": "unless-stopped"
        },
        "sentinel-a": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.sentinel_port_a }} PING | grep -qx PONG"
            ],
            "interval": "2s",
            "timeout": "2s",
            "retries": 15,
            "start_period": "5s"
          },
          "restart": "unless-stopped"
        },
        "redis-b": {
          "healthcheck": {
            "test": [
              "CMD-SHELL",
              "redis-cli --raw -p {{ .Values.data_port_b }} PING | grep -qx PONG"
            ],
            "interval": "2s",
