        "limits": {
          "memory": "128Mi"
        }
      }
    },
    {
      "name": "redis-c",
      "image": "redis@sha256:02419de7eddf55aa5bcf49efb74e88fa8d931b4d77c07eff8a6b22144472b6952",
      "command": [
