{
  "apiVersion": "ferry/v1",
  "kind": "Application",
  "metadata": { "name": "example-http" },
  "services": [{
    "name": "web",
    "image": "busybox:1.36",
    "command": ["sh", "-c", "mkdir -p /www; printf '%s' \"$WELCOME_MESSAGE\" > /www/index.html; exec httpd -f -p 8080 -h /www"],
    "env": [{ "name": "WELCOME_MESSAGE", "value": "{{ .Values.message }}" }],
    "ports": [{ "container": 8080, "published": "{{ .Values.port }}" }],
    "health": {
      "readiness": { "httpGet": { "path": "/", "port": 8080 }, "periodSeconds": 1 },
      "liveness": { "httpGet": { "path": "/", "port": 8080 }, "periodSeconds": 2 }
    },
    "resources": { "limits": { "cpu": "500m", "memory": "64Mi" }, "requests": { "memory": "16Mi" } }
  }]
}
