{
  "contract_version": "1",
  "scope": "Read-only platform data from the execution workspace, and read-only AI Agent nodes using the model API or native CLI platform bridge.",
  "nodes": [
    {
      "type": "ferry.request",
      "type_version": 1,
      "impl_version": "1",
      "phase": "S2",
      "status": "implemented",
      "runtime": {
        "default": "server",
        "allowed": [
          "server"
        ]
      },
      "purity": "side_effect",
      "cache_allowed": false,
      "item_mode": "per_item",
      "inputs": [
        {
          "port": "main",
          "type": "main"
        }
      ],
      "outputs": [
        {
          "port": "main",
          "type": "main"
        }
      ],
      "credential_slots": {},
      "search_aliases": [
        "ferry",
        "platform",
        "api",
        "get",
        "request",
        "code insights",
        "平台数据"
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^/"
          },
          "path_params": {
            "type": "object",
            "maxProperties": 16,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "query": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "minLength": 1,
              "maxLength": 128
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "split_items": {
            "type": "boolean"
          },
          "all_pages": {
            "type": "boolean"
          },
          "max_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "operation",
          "path_params",
          "query",
          "split_items",
          "all_pages",
          "max_pages"
        ],
        "additionalProperties": false
      },
      "expression_fields": [
        "/path_params/*",
        "/query/*"
      ],
      "semantic_rule": "operation must be a GET template of the generated platform tool catalogue; path_params must name exactly its placeholders, each one non-empty segment without '/' or '..'. The workspace always comes from the execution.",
      "example_params": {
        "operation": "/workflows",
        "path_params": {},
        "query": {
          "page_size": 20
        },
        "split_items": true,
        "all_pages": false,
        "max_pages": 50
      }
    },
    {
      "type": "ai.agent.run",
      "type_version": 1,
      "impl_version": "1",
      "phase": "S2",
      "status": "implemented",
      "runtime": {
        "default": "host",
        "allowed": [
          "host",
          "server"
        ]
      },
      "purity": "side_effect",
      "cache_allowed": false,
      "item_mode": "batch",
      "inputs": [
        {
          "port": "main",
          "type": "main"
        }
      ],
      "outputs": [
        {
          "port": "main",
          "type": "main"
        }
      ],
      "credential_slots": {},
      "search_aliases": [
        "ai",
        "agent",
        "mcp",
        "cli",
        "codex",
        "claude",
        "analysis",
        "structured output",
        "json schema",
        "智能体",
        "files",
        "file",
        "pdf",
        "word",
        "excel",
        "ppt",
        "pptx",
        "docx",
        "xlsx",
        "chart",
        "video",
        "文件",
        "生成文件",
        "报告"
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "output_schema": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 30,
            "maximum": 1800
          },
          "max_tool_calls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "files": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "formats": {
                "oneOf": [
                  {
                    "const": "any"
                  },
                  {
                    "type": "array",
                    "maxItems": 30,
                    "items": {
                      "type": "string",
                      "pattern": "^\\.?[A-Za-z0-9]{1,10}$"
                    }
                  }
                ]
              },
              "max_files": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "max_total_mb": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "instructions": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768,
            "default": 1024,
            "description": "API model output token limit per request. Ignored for CLI models."
          }
        },
        "required": [
          "agent_id",
          "prompt",
          "timeout_s",
          "max_tool_calls"
        ],
        "additionalProperties": false
      },
      "expression_fields": [
        "/prompt"
      ],
      "semantic_rule": "agent_id names an enabled Agent the saving user may use using an API model profile or a read-only capable CLI (not Kimi or Grok). prompt is at most 32 KiB; output_schema is a JSON Schema of at most 64 KiB whose root type is object. The node runs once per execution over all input items at the execution location resolved independently for that node: API models call their configured provider on the server without a Runner (host settings are ignored); CLI models use the explicit node target, otherwise a compatible workflow default, otherwise the model candidate Runner hosts (legacy Agent pins remain compatible), with platform tools limited to catalogue GETs under the execution identity intersected with the Agent role. output_schema is required unless files.enabled is true. With files.enabled the Agent's CLI (Codex or Claude only) runs in a fresh Runner-managed working directory where it may write only inside that directory, without network; every regular file it leaves under ./output/ (at most files.max_files, each at most 32 MiB, files.max_total_mb in total, optionally limited to files.formats extensions, content checked against the extension) becomes a workflow file: the single output item gets json.files [{artifact_id,name,mime,size,sha256,download_url,meta}] and binary file_1..file_n, plus the validated JSON object when output_schema is set, otherwise json.summary with the final message. Claude can only write text formats in this mode; Codex can run programs that already exist on the host (python-docx/openpyxl/python-pptx, matplotlib, ffmpeg, LibreOffice...). API Agents use the same GET-only platform tools and schema validation, with one output correction, node timeout and cancellation. API Agents cannot use files.enabled: use report.render after structured output instead. max_tokens optionally controls API output tokens per request (default 1024). Costs and usage are recorded without monetary admission limits; provider concurrency and request rate still apply.",
      "example_params": {
        "agent_id": "1",
        "prompt": "Summarize the input items.",
        "output_schema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "summary"
          ]
        },
        "timeout_s": 600,
        "max_tool_calls": 64
      }
    }
  ]
}
